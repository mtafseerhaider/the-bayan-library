{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mtafseerhaider/the-bayan-library/system/schemas/registry/agent.schema.json",
  "title": "Bayan agent family file",
  "type": "object",
  "required": ["family", "agents"],
  "additionalProperties": false,
  "properties": {
    "family": {"enum": ["core", "quran", "daily", "learning"]},
    "agents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/agent"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "model": {"enum": ["haiku", "sonnet", "opus"]},
    "memoryLayer": {"enum": ["working", "session", "project", "repository", "canonical", "personal-reflection"]},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id", "name", "purpose", "responsibilities", "inputs", "outputs",
        "complexity_class", "default_model", "fallback_model", "permission_level",
        "required_skills", "memory", "token_budget", "escalation_rules",
        "evaluation_metrics", "quality", "reports_to", "collaborates_with"
      ],
      "properties": {
        "agent_id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 3},
        "purpose": {"type": "string", "minLength": 10},
        "responsibilities": {"$ref": "#/$defs/strings", "minItems": 1},
        "inputs": {"$ref": "#/$defs/strings", "minItems": 1},
        "outputs": {"$ref": "#/$defs/strings", "minItems": 1},
        "complexity_class": {"enum": ["A", "B", "C", "D", "E"]},
        "default_model": {"$ref": "#/$defs/model"},
        "fallback_model": {"$ref": "#/$defs/model"},
        "permission_level": {"type": "integer", "minimum": 1, "maximum": 5},
        "required_skills": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": {"type": "array", "items": {"$ref": "#/$defs/memoryLayer"}},
            "write": {"type": "array", "items": {"$ref": "#/$defs/memoryLayer"}}
          }
        },
        "token_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output"],
          "properties": {
            "input": {"type": "integer", "minimum": 0},
            "output": {"type": "integer", "minimum": 0}
          }
        },
        "explanation_levels": {
          "type": "array",
          "items": {"enum": ["eli8", "general", "technical"]}
        },
        "escalation_rules": {"$ref": "#/$defs/strings"},
        "evaluation_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "target"],
            "properties": {
              "metric": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "target": {"type": "string"}
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validation", "failure_handling", "review_gate", "human_approval"],
          "properties": {
            "validation": {"$ref": "#/$defs/strings", "minItems": 1},
            "failure_handling": {"$ref": "#/$defs/strings", "minItems": 1},
            "review_gate": {"enum": ["G0", "G1", "G2", "G3", "G4"]},
            "human_approval": {"enum": ["none", "sampled", "every_item", "required"]}
          }
        },
        "reports_to": {"$ref": "#/$defs/id"},
        "collaborates_with": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
