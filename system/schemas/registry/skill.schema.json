{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mtafseerhaider/the-bayan-library/system/schemas/registry/skill.schema.json",
  "title": "Bayan skill registry",
  "type": "object",
  "required": ["version", "skills"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill_id", "name", "purpose", "input", "output", "dependencies",
          "complexity_class", "execution", "recommended_model",
          "fallback_model", "token_budget"
        ],
        "properties": {
          "skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
          "name": {"type": "string"},
          "purpose": {"type": "string", "minLength": 10},
          "input": {"type": "string"},
          "output": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "complexity_class": {"enum": ["A", "B", "C", "D", "E"]},
          "execution": {"enum": ["script", "hybrid", "model"]},
          "recommended_model": {"enum": ["haiku", "sonnet", "opus"]},
          "fallback_model": {"enum": ["haiku", "sonnet", "opus"]},
          "token_budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "output"],
            "properties": {
              "input": {"type": "integer", "minimum": 0},
              "output": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
