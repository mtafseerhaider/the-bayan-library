{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mtafseerhaider/the-bayan-library/system/schemas/registry/knowledge-graph.schema.json",
  "title": "Knowledge graph ontology",
  "type": "object",
  "required": [
    "version",
    "evidence_levels",
    "node_types",
    "relationship_types",
    "maps"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "node_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "prefix",
          "metadata_dir"
        ],
        "properties": {
          "prefix": {
            "pattern": "^[a-z]+$"
          }
        }
      }
    },
    "relationship_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "inverse",
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "array",
            "minItems": 1
          },
          "target": {
            "type": "array",
            "minItems": 1
          },
          "symmetric": {
            "type": "boolean"
          }
        }
      }
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "node_types",
          "relationship_types"
        ]
      }
    }
  }
}
