{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mtafseerhaider/the-bayan-library/system/schemas/metadata/canon.schema.json",
  "title": "Canon record",
  "type": "object",
  "required": [
    "id",
    "title",
    "methodology",
    "last_updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^canon-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "methodology": {
      "type": "string"
    },
    "last_updated": {
      "type": [
        "string"
      ],
      "format": "date"
    },
    "version": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "work_id"
        ],
        "additionalProperties": false,
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "work_id": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 900,
      "description": "Retrieval layer 1: at most 120 words."
    },
    "executive_summary_path": {
      "type": "string",
      "description": "Retrieval layer 2: path to a <= 600-word executive summary."
    },
    "content_path": {
      "type": "string",
      "description": "Retrieval layer 3: path to the full content page."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "canonical",
        "deprecated"
      ]
    },
    "replaced_by": {
      "type": "string",
      "description": "For deprecated records: the ID that supersedes this one."
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  },
  "additionalProperties": false
}
