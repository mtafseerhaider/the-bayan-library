{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mtafseerhaider/the-bayan-library/system/schemas/metadata/reading-path.schema.json",
  "title": "Reading path record",
  "type": "object",
  "required": [
    "id",
    "title",
    "level",
    "included_books"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^path-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "level": {
      "enum": [
        "Beginner",
        "Intermediate",
        "Scholar"
      ]
    },
    "estimated_books": {
      "type": "integer",
      "minimum": 1
    },
    "included_books": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^book-[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 900,
      "description": "Retrieval layer 1: at most 120 words."
    },
    "executive_summary_path": {
      "type": "string",
      "description": "Retrieval layer 2: path to a <= 600-word executive summary."
    },
    "content_path": {
      "type": "string",
      "description": "Retrieval layer 3: path to the full content page."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "canonical",
        "deprecated"
      ]
    },
    "replaced_by": {
      "type": "string",
      "description": "For deprecated records: the ID that supersedes this one."
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  },
  "additionalProperties": false
}
