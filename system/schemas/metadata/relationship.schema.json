{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mtafseerhaider/the-bayan-library/system/schemas/metadata/relationship.schema.json",
  "title": "Knowledge graph relationship",
  "type": "object",
  "required": [
    "source",
    "relationship",
    "target"
  ],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "string",
      "pattern": "^[a-z]+-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "relationship": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z]+-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "confidence": {
      "enum": [
        "high",
        "moderate",
        "tentative"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "note": {
      "type": "string"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
